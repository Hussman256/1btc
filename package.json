{
  "name": "1btc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@testing-library/react": "16.3.3"
  },
  "scripts": {
    "dev": "npm run dev --workspace @1btc/web",
    "dev:server": "npm run dev --workspace @1btc/server",
    "build": "npm run typecheck --workspaces --if-present && npm run build --workspace @1btc/web",
    "lint": "npm run lint --workspace @1btc/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run typecheck && npm run lint"
  }
}
